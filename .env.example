# OpenAI-compatible inference endpoint. Copy to .env and fill in.
API_KEY=
BASE_URL=
# Optional override; defaults to medgemma-27b-it in code.
MEDGEMMA_MODEL=medgemma-27b-it

# Zenodo personal access token, scopes deposit:write and deposit:actions.
# Only needed by scripts/zenodo_new_version.py.
ZENODO_TOKEN=
